<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hachem_khaled_add_meal"
    android:layout_width="match_parent"
    android:scrollbars="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".AddMealActivity">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/hachem_khaled_toolbar_add_meal_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hachem_khaled_exercise_toolbar_back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/back"
                app:icon="@drawable/baseline_arrow_back_24"
                app:iconGravity="textStart"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"/>
            <TextView
                android:id="@+id/hachem_khaled_exercise_toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/add_mead_title"
                android:textSize="24sp"
                android:layout_gravity="center"
                android:textColor="@android:color/white"
                />
        </androidx.appcompat.widget.Toolbar>

        <View
            android:id="@+id/hachem_khaled_view_add_meal_line"

            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@color/Jordy_blue"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="24dp"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hachem_khaled_pdb">
        </View>

        <TextView
            android:id="@+id/hachem_khaled_tv_meal_healthy"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"

            android:layout_margin="6dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/hachem_khaled_view_add_meal_line"

            android:text="@string/is_meal_healthy">
        </TextView>

        <LinearLayout
            android:id="@+id/hachem_khaled_ll_meal"

            android:layout_marginTop="24dp"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hachem_khaled_view_add_meal_line"
            android:gravity="center"
            >
            <RadioGroup
                android:id="@+id/hachem_khaled_rg_is_healthy"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_margin="8dp"

                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/hachem_khaled_tv_meal_healthy"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="8dp"
                >

                <RadioButton
                    android:id="@+id/hachem_khaled_rb_is_healthy_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="60dp"
                    android:layout_weight="1"
                    android:text="@string/yes"
                    tools:ignore="TouchTargetSizeCheck" />

                <RadioButton
                    android:id="@+id/hachem_khaled_rb_is_healthy_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="60dp"
                    android:layout_weight="1"
                    android:text="@string/no"
                    tools:ignore="TouchTargetSizeCheck" />
            </RadioGroup>
        </LinearLayout>
        <Button
            android:id="@+id/hachem_khaled_pdb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_margin="24dp"


            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hachem_khaled_til_meal_calories"
            android:text="@string/pick_date"
            android:layout_marginTop="16dp">
        </Button>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/hachem_khaled_til_meal_description"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hachem_khaled_ll_meal">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hachem_khaled_tiet_meal_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:inputType="textMultiLine"
                android:hint="@string/description">
            </com.google.android.material.textfield.TextInputEditText>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/hachem_khaled_til_meal_calories"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="8dp"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hachem_khaled_toolbar_add_meal_header">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/hachem_khaled_tiet_meal_calories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:inputType="number"

                android:hint="@string/calories">
            </com.google.android.material.textfield.TextInputEditText>
        </com.google.android.material.textfield.TextInputLayout>
        <Button
            android:id="@+id/hachem_khaled_btn_save_meal"
            android:layout_marginTop="40dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hachem_khaled_til_meal_description"
            android:paddingHorizontal="50dp"
            android:text="@string/save"

            >
        </Button>
        <TextView
            android:id="@+id/hachem_khaled_tv_selected_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        </TextView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>