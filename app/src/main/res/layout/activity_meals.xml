<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/honciu_eduard_marian_meals"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/honciu_eduard_marian_meal_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/honciu_eduard_marian_meal_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_meal_journal"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:layout_gravity="center"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/honciu_eduard_marian_meal_fab_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/meals_back"
            app:icon="@drawable/baseline_arrow_back_24"
            app:iconGravity="textStart"
            android:layout_gravity="start"
            android:paddingHorizontal="0dp" />
    </androidx.appcompat.widget.Toolbar>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/honciu_eduard_marian_cl_calories_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/honciu_eduard_marian_meal_toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="8dp">


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/honciu_eduard_marian_til_calories_goal_min"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/honciu_eduard_marian_til_calories_goal_max"
            android:layout_marginEnd="4dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/honciu_eduard_marian_tiet_calories_goal_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/calories_goal_min"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/honciu_eduard_marian_til_calories_goal_max"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@id/honciu_eduard_marian_til_calories_goal_min"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="4dp"
            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/honciu_eduard_marian_tiet_calories_goal_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/calories_goal_max"
                android:inputType="number"/>
        </com.google.android.material.textfield.TextInputLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>



    <Button
        android:id="@+id/honciu_eduard_marian_btn_add_meal"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/honciu_eduard_marian_cl_calories_goal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        android:text="@string/add_meal_journal"
        >
    </Button>

    <ExpandableListView
        android:id="@+id/honciu_eduard_marian_elv_meal_journal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/honciu_eduard_marian_btn_add_meal"
        />

</androidx.constraintlayout.widget.ConstraintLayout>