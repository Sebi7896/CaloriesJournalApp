<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/honciu_eduard_marian_lb_list_meal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp">

    <TextView
        android:id="@+id/honciu_eduard_marian_tv_description_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintWidth_percent="0.65"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="13sp"
        tools:text="Description" />

    <TextView
        android:id="@+id/honciu_eduard_marian_tv_calories_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        app:layout_constraintWidth_percent="0.2"
        app:layout_constraintStart_toEndOf="@id/honciu_eduard_marian_tv_description_list"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:textSize="13sp"
        tools:text="Calories" />

    <TextView
        android:id="@+id/honciu_eduard_marian_tv_healthy_list"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="5dp"
        app:layout_constraintWidth_percent="0.15"
        app:layout_constraintStart_toEndOf="@id/honciu_eduard_marian_tv_calories_list"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="13sp"
        tools:text="Healthy" />
</androidx.constraintlayout.widget.ConstraintLayout>


