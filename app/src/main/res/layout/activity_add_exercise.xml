<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tanasescu_robert_gabriel_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="30dp"
    tools:context=".AddExerciseActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/tanasescu_robert_gabriel_exercise_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"  >
        <com.google.android.material.button.MaterialButton
            android:id="@+id/tanasescu_robert_gabriel_exercise_toolbar_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/back"
            app:icon="@drawable/baseline_arrow_back_24"
            app:iconGravity="textStart"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"/>
        <TextView
            android:id="@+id/tanasescu_robert_gabriel_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_exercise_add_exercise"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:layout_gravity="center"/>
    </androidx.appcompat.widget.Toolbar>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tanasescu_robert_gabriel_txtNameLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeErrorColor="@android:color/holo_red_light"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tanasescu_robert_gabriel_exercise_toolbar" >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tanasescu_robert_gabriel_txtName"
            android:hint="@string/add_exercise_exercise_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >
        </com.google.android.material.textfield.TextInputEditText>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/tanasescu_robert_gabriel_layoutDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tanasescu_robert_gabriel_txtNameLayout"
        android:weightSum="100" >

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tanasescu_robert_gabriel_txtDateLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="85"
            >
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tanasescu_robert_gabriel_txtDate"
                android:hint="@string/add_exercise_date_hint"
                android:focusable="false"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" >
            </com.google.android.material.textfield.TextInputEditText>
        </com.google.android.material.textfield.TextInputLayout>

        <Space
            android:id="@+id/tanasescu_robert_gabriel_space"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tanasescu_robert_gabriel_btnCalendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="13"
            android:contentDescription="@string/todo"
            app:icon="@android:drawable/ic_menu_my_calendar"
            app:iconSize="24dp"
            app:iconGravity="textStart"
            android:layout_gravity="center"
            app:iconPadding="0dp"
            />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tanasescu_robert_gabriel_txtCaloriesLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:boxStrokeErrorColor="@android:color/holo_red_light"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tanasescu_robert_gabriel_layoutDate" >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tanasescu_robert_gabriel_txtCalories"
            android:hint="@string/add_exercise_calories_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" >
        </com.google.android.material.textfield.TextInputEditText>
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/tanasescu_robert_gabriel_timeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="100"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tanasescu_robert_gabriel_txtCaloriesLayout" >
        <TextView
            android:id="@+id/tanasescu_robert_gabriel_lblTime"
            android:text="@string/add_exercise_time_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="30"/>
        <NumberPicker
            android:id="@+id/tanasescu_robert_gabriel_numberMinutes"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="35"

            />
        <NumberPicker
            android:id="@+id/tanasescu_robert_gabriel_numberSeconds"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_weight="35"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tanasescu_robert_gabriel_layoutDifficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:weightSum="100"
        app:layout_constraintTop_toBottomOf="@+id/tanasescu_robert_gabriel_timeLayout" >
        <TextView
            android:id="@+id/tanasescu_robert_gabriel_lblDifficulty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="22"
            android:text="@string/add_exercise_difficulty_hint"
            />
        <TextView
            android:id="@+id/tanasescu_robert_gabriel_lblRating"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="78" />
    </LinearLayout>
    <RatingBar
        android:id="@+id/tanasescu_robert_gabriel_ratingDifficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tanasescu_robert_gabriel_layoutDifficulty"
        android:numStars="5"
        android:stepSize="0.5"
        android:isIndicator="false" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tanasescu_robert_gabriel_txtDescriptionLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tanasescu_robert_gabriel_ratingDifficulty" >
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tanasescu_robert_gabriel_txtDescription"
            android:hint="@string/exercises_list_description_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        </com.google.android.material.textfield.TextInputEditText>
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/tanasescu_robert_gabriel_btnSave"
        android:text="@string/add_exercise_btn_save_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
