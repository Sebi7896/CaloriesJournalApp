<resources>
    <style name="Base.Theme.CaloriesJournalApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="toolbarStyle">@style/CaloriesJournalToolbarStyle</item>
        <item name="materialButtonStyle">@style/MyButtonStyle</item>

        <item name="android:windowBackground">@color/grey</item>
        <item name="textInputStyle">@style/MyTextInputLayoutStyle</item>
        <item name="ratingBarStyle">@style/RatingBarStyle</item>
        <item name="radioButtonStyle">@style/MyRadioButtonStyle</item>
    </style>

    <style name="CaloriesJournalToolbarStyle" parent="Widget.AppCompat.Toolbar">
    <item name="android:background">@color/Air_superiority_blue</item>
        <item name="titleTextColor">@android:color/white</item>
    </style>

    <style name="MyButtonStyle" parent="@style/Widget.Material3.Button.OutlinedButton">
        <item name="background">@color/Black</item>
        <item name="android:textColor">@color/Black</item>
        <item name="iconTint">@color/Black</item>
        <item name="iconSize">15sp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="MyTextInputLayoutStyle" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/LightGrey</item>

        <item name="hintTextColor">@color/Black</item>
        <item name="boxBackgroundMode">filled</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <style name="MyRadioButtonStyle" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="buttonTint">@color/Jordy_blue</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="RatingBarStyle" parent="Widget.AppCompat.RatingBar">
        <item name="android:progressTint">@color/Jordy_blue</item>
    </style>
    <style name="Theme.CaloriesJournalApp" parent="Base.Theme.CaloriesJournalApp" />
</resources>